        { "file": "src/lib/ui/selectors/useSelectModal.ts", "symbol": "useSelectModal" }
      ],
      "params": [
        { "name": "name", "type": "string", "default": "空", "notes": "按当前语言的角色长名做不区分大小写的包含匹配" },
        { "name": "element", "type": "属性多选", "default": "不限" },
        { "name": "path", "type": "命途多选", "default": "不限" }
      ],
      "conditions": "基准生成器和套装基准审计只列出有输出类模拟评分配置的角色。个别入口不允许清空选择。",
