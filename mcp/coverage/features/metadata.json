        { "name": "backgroundOffset", "type": "{ x, y, z }", "default": "0" },
        { "name": "preset", "type": "SHINE | NATURAL", "default": "SHINE" },
        { "name": "showCrosshairs", "type": "boolean", "default": "false" }
