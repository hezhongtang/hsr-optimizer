    {
      "id": "metadata.imageCenter.edit",
      "title": "立绘与光锥图居中调校",
      "surface": { "page": "METADATA_TEST", "entry": "「Image center editor」面板" },
      "kind": "view",
      "action": "给维护者调校角色立绘、动态立绘和光锥图在展示卡里的位置与缩放。选一个角色后并排显示静态立绘和动态立绘两个取景框，直接在图上拖动改位置、滚轮改缩放，也可以填数字；两个框之间可以复制粘贴中心点。光锥部分选一把光锥后调纵向偏移和缩放。最下面是一张完整展示卡的预览，可换角色、光锥和光影预设，分别调立绘中心和背景偏移。每组数值旁都给出一段可直接贴进源码配置的文本，带复制按钮。可以打开十字准线辅助对齐，重置按钮恢复到配置里现有的值。",
      "upstream": [
        { "file": "src/lib/tabs/tabMetadata/ImageCenterEditor.tsx", "symbol": "ImageCenterEditorSection" },
        { "file": "src/lib/tabs/tabMetadata/ImageCenterEditor.tsx", "symbol": "CharacterEditor" },
        { "file": "src/lib/tabs/tabMetadata/ImageCenterEditor.tsx", "symbol": "CharCenterControls" },
        { "file": "src/lib/tabs/tabMetadata/ImageCenterEditor.tsx", "symbol": "LightConeCenterEditor" },
        { "file": "src/lib/tabs/tabMetadata/ImageCenterEditor.tsx", "symbol": "CharacterPreviewEditor" },
        { "file": "src/lib/tabs/tabMetadata/ImageCenterEditor.tsx", "symbol": "useDragInteraction" }
