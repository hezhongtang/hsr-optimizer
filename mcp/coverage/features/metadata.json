{
  "area": "metadata",
  "title": "元数据测试页",
  "features": [
    {
      "id": "metadata.setAuditor.run",
      "title": "套装基准审计",
      "surface": { "page": "METADATA_TEST", "overlay": "角色选择弹窗、光锥选择弹窗、队友编辑弹窗", "entry": "「Set benchmark auditor」面板。页面没有侧边栏入口，只能在地址栏输入 #metadata 打开" },
      "kind": "compute",
      "action": "给维护者检查角色评分配置里的推荐套装是否有遗漏。选定角色、星魂、光锥、叠影和三名队友，勾选要扫的套装类型、速度档位、输出或副 C、是否带充能绳，以及按 100% 还是 200% 基准比较。工具先用该角色配置里的第一组推荐套装算出参照分，再把全部四件套、二加二组合和饰品套装逐个替换进去重算，按与参照分的差距排序：不在推荐名单里却持平或更高的标红，差距在 2% 以内的标黄，已在名单里的标绿底。点一行展开看每组参数下的分数、参照分和差距。运行中显示完成数和预计剩余时间，可以取消。",
      "upstream": [
        { "file": "src/lib/tabs/tabMetadata/setAuditor/SetBenchmarkAuditor.tsx", "symbol": "SetBenchmarkAuditor" },
        { "file": "src/lib/tabs/tabMetadata/setAuditor/SetBenchmarkAuditor.tsx", "symbol": "CheckboxGroupField" },
        { "file": "src/lib/tabs/tabMetadata/setAuditor/setAuditorEngine.ts", "symbol": "runAudit" },
        { "file": "src/lib/tabs/tabMetadata/setAuditor/setAuditorConstants.ts", "symbol": "computeFlag" },
        { "file": "src/lib/tabs/tabMetadata/setAuditor/SetAuditorSummaryTable.tsx", "symbol": "SetAuditorSummaryTable" },
        { "file": "src/lib/tabs/tabMetadata/setAuditor/SetAuditorSummaryTable.tsx", "symbol": "SummarySection" },
        { "file": "src/lib/tabs/tabMetadata/setAuditor/SetAuditorSummaryTable.tsx", "symbol": "SummaryRow" },
        { "file": "src/lib/tabs/tabMetadata/setAuditor/SetAuditorDrillDown.tsx", "symbol": "SetAuditorDrillDown" }
      ],
      "params": [
        { "name": "characterId", "type": "CharacterId", "notes": "必须有输出类模拟评分配置；选定后星魂重置为 0、叠影重置为 1，队友取配置里的推荐队友" },
        { "name": "lightCone", "type": "LightConeId" },
        { "name": "setTypes", "type": "relic4p | relic2p2p | ornament 多选", "default": "relic4p、ornament" },
        { "name": "spdBreakpoints", "type": "0 | 133 | 160 | 200 多选", "default": "0、133、160" },
        { "name": "modes", "type": "dps | subDps 多选", "default": "按角色配置：副 C 角色为 subDps，否则 dps" },
        { "name": "errRope", "type": "noErr | err 多选", "default": "按角色配置：允许充能绳的角色两项都选，否则只选 noErr" },
        { "name": "scoringModes", "type": "benchmark | perfection 多选", "default": "perfection" }
      ],
      "conditions": "遗器套装和饰品套装分开扫：扫遗器时饰品固定为参照饰品，扫饰品时遗器固定为参照遗器，两者之间的联动发现不了，页面上有同样的提示。二加二组合按两件套效果归类后取代表套装配对，不是所有套装两两配对。任一多选项为空时不能运行。",
      "runtime": "node",
      "state": { "owner": "SetBenchmarkAuditor 的本地状态；队友借用 useBenchmarksTabStore.teammate0..2", "lifecycle": "ephemeral" },
      "sideEffects": ["换角色会改写基准生成器页的三名队友"],
      "mcp": { "status": "implemented", "tools": ["benchmark_runs"] },
      "scope": "baseline",
      "upstreamChange": "none",
      "acceptance": {
        "cases": [
          "同一角色、光锥、队友和勾选项下，返回的每个套装的最佳差距、对应参数和红黄标记与网页端汇总表逐行一致",
          "返回的参照套装与网页端「Compared to」后显示的一致",
          "展开数据（每组参数下的分数、参照分、差距）与网页端展开行一致",
          "带进度令牌时按已完成的基准数发送进度，取消后不返回半截结果"
        ],
        "tests": ["mcp/scripts/smoke-simulation.mjs", "mcp/scripts/smoke-analysis.mjs"]
      }
    },
