  "title": "导入页：存档载入/保存/清除、扫描器文件导入、实时扫描",
  "features": [
    {
      "id": "import.save.load",
      "title": "从文件载入存档",
      "surface": {
        "page": "IMPORT",
        "entry": "「载入数据」页签：选择 .json → 确认页 →「使用上传的数据」"
      },
      "kind": "write",
      "action": "读入文件后分两步：先展示文件里的遗器数与角色数；确认后 loadSaveData(save, autosave=false)（sanitize 取默认 true）整体替换当前数据，随后 SaveState.save() 落盘。",
      "upstream": [
        {
          "file": "src/lib/tabs/tabImport/LoadDataSubmenu.tsx",
          "symbol": "LoadDataSubmenu"
        },
        {
          "file": "src/lib/tabs/tabImport/LoadDataSubmenu.tsx",
          "symbol": "UploadFileStage"
        },
        {
          "file": "src/lib/tabs/tabImport/LoadDataSubmenu.tsx",
          "symbol": "ConfirmDataStage"
        },
        {
          "file": "src/lib/tabs/tabImport/LoadDataSubmenu.tsx",
          "symbol": "loadConfirmed"
        },
        {
          "file": "src/lib/services/persistenceService.ts",
          "symbol": "loadSaveData"
        },
        {
          "file": "src/lib/stores/relic/relicStore.ts",
          "symbol": "setRelics"
        }
      ],
      "params": [
        {
          "name": "file",
          "type": ".json 文件",
          "notes": "fribbels-optimizer-save.json 格式"
        },
        {
          "name": "sanitize",
          "type": "boolean",
          "default": "true（手动载入）",
          "notes": "为 true 时不从文件恢复自定义的扫描器 websocket 地址"
        }
      ],
      "conditions": "文件带 fileType 或 source 字段（即扫描器文件）或缺少 relics/characters 时，确认页显示「无效存档，是否想用扫描器导入」，无法继续。",
      "runtime": "node",
      "state": {
        "owner": "全部 store",
        "lifecycle": "persisted",
        "saveKey": "*"
      },
      "sideEffects": [
        "替换全部数据并跑迁移链",
        "清空角色页的聚焦角色",
        "立即 SaveState.save()"
      ],
      "mcp": {
        "status": "verified",
        "tools": [
          "load_save"
        ]
      },
      "scope": "baseline",
      "upstreamChange": "none",
      "acceptance": {
        "cases": [
          "同一存档经网页「载入数据」与 load_save 载入后，SaveState.save() 输出逐键一致",
          "带自定义 websocketUrl 的存档按手动载入语义载入后，websocketUrl 仍是默认值",
          "扫描器文件与缺少 relics/characters 的文件被拒绝，当前数据不变"
        ],
        "tests": [
          "mcp/scripts/smoke-archive.mjs",
          "mcp/scripts/parity.mjs"
        ],
        "evidence": [
          "mcp/coverage/evidence/import.json#import.save.load cases 1-3 PASS 2026-10-09 (8ac1d045)"
        ]
      }
    },
