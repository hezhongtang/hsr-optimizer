      "upstreamChange": "none",
      "acceptance": {
        "cases": ["get_character 返回的六槽遗器、已存表单、配装列表与评分元数据与网页选中该角色后看到的一致"],
        "tests": ["mcp/scripts/smoke-query.mjs", "mcp/scripts/smoke-equip.mjs"]
      }
    },
