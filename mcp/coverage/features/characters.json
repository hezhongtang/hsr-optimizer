      "kind": "read",
      "action": "把聚焦角色设为该行角色，右侧渲染其展示卡（装备、属性、评分等，卡片本身见 preview 域）。聚焦角色也是角色菜单各项操作的对象。",
      "upstream": [
        { "file": "src/lib/tabs/tabCharacters/CharacterGrid.tsx", "symbol": "SortableCharacterRow" },
        { "file": "src/lib/tabs/tabCharacters/CharacterGrid.tsx", "symbol": "handleRowClick" },
        { "file": "src/lib/tabs/tabCharacters/useCharacterTabStore.ts", "symbol": "setFocusCharacter" },
        { "file": "src/lib/tabs/tabCharacters/CharactersPanelContent.tsx", "symbol": "CharactersPanelContent" }
