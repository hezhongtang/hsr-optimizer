      "state": { "owner": "useCharacterStore.characters（数组顺序）", "lifecycle": "persisted", "saveKey": "characters" },
      "sideEffects": ["SaveState.delayedSave()"],
      "mcp": { "status": "implemented", "tools": ["set_character_rank"] },
      "scope": "baseline",
      "upstreamChange": "none",
      "acceptance": {
