{
  "area": "characters",
  "title": "角色页：角色列表、角色菜单、配装、评分权重、行迹",
  "features": [
    {
      "id": "characters.list.read",
      "title": "浏览与筛选角色列表",
      "surface": { "page": "CHARACTERS", "entry": "左侧角色网格；上方搜索框、命途与属性筛选条" },
      "kind": "read",
      "action": "按优先级顺序列出全部角色（头像、光锥、序号）。可按名称子串（当前语言的长名，忽略大小写）、命途多选、属性多选筛选，三者同时生效。",
      "upstream": [
        { "file": "src/lib/tabs/tabCharacters/CharacterGrid.tsx", "symbol": "CharacterGrid" },
        { "file": "src/lib/tabs/tabCharacters/CharacterGrid.tsx", "symbol": "CharacterRowContent" },
        { "file": "src/lib/tabs/tabCharacters/CharacterGrid.tsx", "symbol": "DragOverlayRow" },
        { "file": "src/lib/tabs/tabCharacters/FilterBar.tsx", "symbol": "FilterBar" },
        { "file": "src/lib/tabs/tabCharacters/useCharacterTabStore.ts", "symbol": "setNameFilter" },
        { "file": "src/lib/tabs/tabCharacters/useCharacterTabStore.ts", "symbol": "setElementFilter" },
        { "file": "src/lib/tabs/tabCharacters/useCharacterTabStore.ts", "symbol": "setPathFilter" }
      ],
      "params": [
        { "name": "name", "type": "string", "default": "''" },
        { "name": "path", "type": "PathName[]", "default": "[]" },
        { "name": "element", "type": "ElementName[]", "default": "[]" }
      ],
      "runtime": "node",
      "state": { "owner": "useCharacterTabStore.filters", "lifecycle": "session" },
      "mcp": {
        "status": "partial",
        "tools": ["list_characters"],
        "gaps": "list_characters 的 path 与 element 参数只接受单个值，也没有名称子串筛选的 name 参数；网页筛选态是 name 子串 + 命途多选 + 属性多选三者同时生效。名称模糊匹配可由调用方拿列表后自行做，多选筛选做不到。",
        "candidates": ["list_characters(name, path[], element[])"]
      },
      "scope": "baseline",
      "upstreamChange": "none",
      "acceptance": {
        "cases": ["list_characters 的顺序、rank 与网页角色网格一致；按命途、属性筛选的结果集与网页筛选条一致；补齐多选与 name 参数后与网页三轴筛选逐一对拍"],
        "tests": ["mcp/scripts/smoke-query.mjs"]
      }
    },
    {
      "id": "characters.detail.read",
