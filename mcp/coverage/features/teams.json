      "scope": "baseline",
      "upstreamChange": "mirror",
      "acceptance": {
        "cases": [
          "空队伍里给第一个槽位选一个存有自定义评分队伍的角色，返回的四个槽位与网页自动补位后的结果一致",
          "选一个未拥有的角色后，两边存档的 characters 都多出该角色（默认表单、空装备）",
          "把已在第三槽的角色选进第一槽后，第三槽变空"
        ],
        "tests": ["mcp/scripts/smoke-teams.mjs"],
        "evidence": [
          "mcp/coverage/evidence/teams.json#teams.working.setSlot cases 1,2,3 PASS 2026-10-08 (browser-parity)"
        ]
      }
