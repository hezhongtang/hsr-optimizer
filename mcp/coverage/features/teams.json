      "upstream": [
        { "file": "src/lib/tabs/tabTeamShowcase/useTeamShowcase.ts", "symbol": "setSlot" },
        { "file": "src/lib/tabs/tabTeamShowcase/TeamShowcaseLayout.tsx", "symbol": "setSlot" },
        { "file": "src/lib/tabs/tabTeamShowcase/SlotPicker.tsx", "symbol": "SlotPicker" },
        { "file": "src/lib/tabs/tabTeamShowcase/SlotCellOverlay.tsx", "symbol": "openPicker" },
        { "file": "src/lib/tabs/tabTeamShowcase/SlotCellOverlay.tsx", "symbol": "onRemove" },
        { "file": "src/lib/tabs/tabTeamShowcase/teamShowcaseModel.ts", "symbol": "autofillTeamSlots" },
        { "file": "src/lib/tabs/tabTeamShowcase/teamShowcaseScoring.ts", "symbol": "resolveCustomAutofillTeammateIds" },
        { "file": "src/lib/tabs/tabTeamShowcase/teamShowcaseController.ts", "symbol": "ensureRosterCharacters" }
      ],
      "params": [
        { "name": "index", "type": "0 | 1 | 2 | 3", "notes": "TEAM_SIZE = 4；第一个槽位在同步基准时被当作主 C" },
        { "name": "characterId", "type": "CharacterId | null", "notes": "选择器列出全部角色，不限已拥有；null 为移除" }
      ],
      "conditions": "自动补位只用已拥有的角色，取展示卡显示顺序里第一个选了自定义队的评分配置的队友。角色从列表里被删除后，对应槽位自动清空。",
      "runtime": "node",
      "state": { "owner": "useTeamShowcase 组件内的 workingTeam", "lifecycle": "ephemeral" },
      "sideEffects": ["选了未拥有的角色时把它加进角色列表（位置遵守 NewCharacterDefaultRank）并 SaveState.delayedSave()"],
